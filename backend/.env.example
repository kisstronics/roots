# Only the database connection is read from the environment.
# Session, Google, mail, and site settings are rows in app_settings:
# SESSION_SECRET, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, GOOGLE_CALLBACK_URL,
# APP_PUBLIC_URL, ADMIN_EMAIL, APP_HOSTS, COOKIE_SECURE,
# SMTP_HOST, SMTP_PORT, SMTP_SECURE, SMTP_USER, SMTP_PASS, MAIL_FROM
DATABASE_URL=postgres://our_roots:our_roots@127.0.0.1:5432/our_roots
