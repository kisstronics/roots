# API: https://api.sknics.com
# UI: https://roots.sknics.com/roots
#
# DATABASE_URL is the only value read from the environment. Set it on the API host.
# Store the other lines in app_settings.

DATABASE_URL=

APP_PUBLIC_URL=https://roots.sknics.com/roots
GOOGLE_CALLBACK_URL=https://api.sknics.com/api/auth/google/callback
APP_HOSTS=roots.sknics.com
COOKIE_SECURE=true
