{
  "redirects": [
    { "source": "/", "destination": "/roots/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/roots/assets/:path*", "destination": "/assets/:path*" },
    { "source": "/roots/families/:path*", "destination": "/families/:path*" },
    { "source": "/roots/favicon.svg", "destination": "/favicon.svg" },
    { "source": "/roots", "destination": "/index.html" },
    { "source": "/roots/", "destination": "/index.html" },
    { "source": "/roots/:path*", "destination": "/index.html" }
  ]
}
